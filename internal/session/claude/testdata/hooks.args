-p --input-format stream-json --output-format stream-json --verbose --model claude-sonnet-5-5 --effort low --setting-sources project --strict-mcp-config --settings {"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"cat >> /tmp/stream-json-out/hooks-command.log; echo >> /tmp/stream-json-out/hooks-command.log; echo SessionStart >> /tmp/stream-json-out/hooks-command.log"}]}],"UserPromptSubmit":[{"hooks":[{"type":"command","command":"cat >> /tmp/stream-json-out/hooks-command.log; echo >> /tmp/stream-json-out/hooks-command.log; echo UserPromptSubmit >> /tmp/stream-json-out/hooks-command.log"}]}],"PreToolUse":[{"hooks":[{"type":"command","command":"cat >> /tmp/stream-json-out/hooks-command.log; echo >> /tmp/stream-json-out/hooks-command.log; echo PreToolUse >> /tmp/stream-json-out/hooks-command.log"}]}],"PostToolUse":[{"hooks":[{"type":"command","command":"cat >> /tmp/stream-json-out/hooks-command.log; echo >> /tmp/stream-json-out/hooks-command.log; echo PostToolUse >> /tmp/stream-json-out/hooks-command.log"}]}],"Stop":[{"hooks":[{"type":"command","command":"cat >> /tmp/stream-json-out/hooks-command.log; echo >> /tmp/stream-json-out/hooks-command.log; echo Stop >> /tmp/stream-json-out/hooks-command.log"}]}]}} --include-hook-events --permission-prompt-tool stdio
