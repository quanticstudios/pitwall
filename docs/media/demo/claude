#!/bin/sh
set -u
state=${DEMO_STATE:-done}
transcript=${DEMO_TRANSCRIPT:-}
prompt=${DEMO_PROMPT:-Fix the failing test}
sid=${DEMO_SESSION:-$(cat /proc/sys/kernel/random/uuid)}

hook() {
	printf '{"hook_event_name":"%s","session_id":"%s","cwd":"%s","permission_mode":"bypassPermissions"%s}' \
		"$1" "$sid" "$PWD" "$2" | pitwall hook claude
}

if [ -n "$transcript" ]; then
	hook SessionStart ",\"source\":\"startup\",\"transcript_path\":\"$transcript\""
else
	hook SessionStart ',"source":"startup","transcript_path":null'
fi
hook UserPromptSubmit ",\"prompt\":\"$prompt\""
case $state in
done) hook Stop ",\"last_assistant_message\":\"${DEMO_REPLY:-Done.}\"" ;;
approval)
	hook PermissionRequest ",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"${DEMO_COMMAND:-npm run migrate}\"}"
	hook Notification ",\"notification_type\":\"permission_prompt\",\"message\":\"Claude needs your permission to use Bash\""
	;;
input) hook PreToolUse ",\"tool_name\":\"AskUserQuestion\",\"tool_input\":{\"questions\":[{\"question\":\"${DEMO_QUESTION:-Which database should the queue use?}\",\"options\":[{\"label\":\"Postgres\"},{\"label\":\"Redis\"}]}]}" ;;
esac

printf '\033[2J\033[H'
printf '\033[38;5;174m ✻\033[0m Claude Code v2.1.328\n'
printf '   Opus 5.5 · High effort\n   %s\n\n' "$PWD"
printf '\033[2m> %s\033[0m\n\n' "$prompt"
case $state in
done) printf '\033[38;5;174m●\033[0m %s\n' "${DEMO_REPLY:-Done.}" ;;
approval) printf ' Bash command\n\n   %s\n\n Do you want to proceed?\n \033[36m❯ 1. Yes\033[0m\n   2. No\n' "${DEMO_COMMAND:-npm run migrate}" ;;
input) printf ' %s\n\n \033[36m❯ 1. Postgres\033[0m\n   2. Redis\n' "${DEMO_QUESTION:-Which database should the queue use?}" ;;
*) printf '\033[38;5;174m✻\033[0m Working… (esc to interrupt)\n' ;;
esac
printf '\n────────────────────────────────────────\n> \n────────────────────────────────────────\n'
printf '  \033[31m⏵⏵ bypass permissions on\033[0m (shift+tab to cycle)\n'
while IFS= read -r _; do :; done
