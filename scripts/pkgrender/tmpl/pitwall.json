{
    "version": "{{.Version}}",
    "description": "Terminal multiplexer for coding agents",
    "homepage": "https://github.com/quanticstudios/pitwall",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/quanticstudios/pitwall/releases/download/{{.Tag}}/pitwall_windows_amd64.zip",
            "hash": "{{sum "pitwall_windows_amd64.zip"}}"
        },
        "arm64": {
            "url": "https://github.com/quanticstudios/pitwall/releases/download/{{.Tag}}/pitwall_windows_arm64.zip",
            "hash": "{{sum "pitwall_windows_arm64.zip"}}"
        }
    },
    "bin": "pitwall.exe",
    "checkver": {
        "url": "https://api.github.com/repos/quanticstudios/pitwall/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/quanticstudios/pitwall/releases/download/v$version/pitwall_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/quanticstudios/pitwall/releases/download/v$version/pitwall_windows_arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt"
        }
    }
}
